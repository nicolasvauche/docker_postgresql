# Version majeure (16 par defaut) ou exacte (exemple : 16.15).
# L'image officielle utilise la variante Debian Bookworm.
POSTGRES_VERSION=16
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_DB=app
# dev.ps1 init genere le mot de passe lors de la creation de .env.
# Consultez ensuite la ligne POSTGRES_PASSWORD dans .env.
POSTGRES_PASSWORD=

# Facultatif : retirez le # de la ligne suivante pour definir un nom de projet.
# Choisissez-le avant le premier start et conservez-le ensuite.
# COMPOSE_PROJECT_NAME=my-postgresql-project
